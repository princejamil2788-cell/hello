/**
 * Helper to format current BD time (Asia/Dhaka, UTC+6) and local browser time
 */
function formatBDTime(date = new Date()) {
  try {
    return new Intl.DateTimeFormat("en-GB", {
      timeZone: "Asia/Dhaka",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    }).format(date);
  } catch {
    return date.toTimeString().slice(0, 8);
  }
}

/**
 * Given a news time like "19:30" or "07:30 PM" or "20:15", compute a clean 1M entry window
 * e.g., +3s to +8s after release for a 1-minute candle/trade.
 */
function computeOneMinuteEntryGuide(newsTimeStr) {
  if (!newsTimeStr || typeof newsTimeStr !== "string") {
    return {
      entryWindow: "নিউজ রিলিজের +০৩ সেকেন্ডে",
      expiryNote: "১ মিনিট (1M) এক্সপায়ারি / ক্যান্ডেল ক্লোজ",
    };
  }

  // Try matching HH:MM (24h) or HH:MM AM/PM
  const match24 = newsTimeStr.trim().match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?$/);
  const match12 = newsTimeStr
    .trim()
    .match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(AM|PM)$/i);

  let hours = null;
  let minutes = null;

  if (match24) {
    hours = parseInt(match24[1], 10);
    minutes = parseInt(match24[2], 10);
  } else if (match12) {
    hours = parseInt(match12[1], 10);
    minutes = parseInt(match12[2], 10);
    const period = match12[4].toUpperCase();
    if (period === "PM" && hours !== 12) hours += 12;
    if (period === "AM" && hours === 12) hours = 0;
  }

  if (
    hours === null ||
    minutes === null ||
    Number.isNaN(hours) ||
    Number.isNaN(minutes) ||
    hours > 23 ||
    minutes > 59
  ) {
    return {
      entryWindow: `${newsTimeStr} এর ঠিক ৩–৫ সেকেন্ড পর`,
      expiryNote: "১ মিনিট (1M) ট্রেড ডিউরেশন",
    };
  }

  const hh = String(hours).padStart(2, "0");
  const mm = String(minutes).padStart(2, "0");
  return {
    entryWindow: `${hh}:${mm}:03 – ${hh}:${mm}:08`,
    expiryNote: `১ মিনিট (1M) — পরবর্তী ক্যান্ডেল (${hh}:${String((minutes + 1) % 60).padStart(2, "0")}:00) পর্যন্ত`,
  };
}

