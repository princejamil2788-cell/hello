/**
 * Normalize & enrich parsed signals from Gemini JSON so every signal has consistent fields
 * and sensible 1-minute timing even if the model omits entry_time.
 */
function normalizeSignalsArray(rawSignals, fallbackTitle = "ইকোনমিক নিউজ সিগন্যাল") {
  if (!Array.isArray(rawSignals) || rawSignals.length === 0) return [];

  // Filter out any WAIT signal candidates and normalize BUY/SELL
  const filteredRaw = rawSignals.filter((item) => {
    const sigRaw = String(item?.signal || "").toUpperCase();
    return sigRaw.includes("BUY") || sigRaw.includes("SELL") || sigRaw.includes("CALL") || sigRaw.includes("PUT");
  });

  // If raw signals didn't yield enough non-WAIT signals, fall back to valid actionable items
  const sourceList = filteredRaw.length > 0 ? filteredRaw : rawSignals;

  return sourceList.slice(0, 5).map((item, index) => {
    const impactRaw = String(item?.impact || "medium").toLowerCase();
    const impact =
      impactRaw.includes("high") || impactRaw.includes("red")
        ? "high"
        : impactRaw.includes("low")
        ? "low"
        : "medium";

    const biasRaw = String(item?.currency_bias || "bullish").toLowerCase();
    const currency_bias = biasRaw.includes("bear") ? "bearish" : "bullish";

    const sigRaw = String(item?.signal || "").toUpperCase();
    // Strictly map to BUY or SELL. NEVER allow WAIT.
    const signal = sigRaw.includes("SELL") || sigRaw.includes("PUT") ? "SELL" : "BUY";

    const confRaw = String(item?.confidence || "medium").toLowerCase();
    const confidence = confRaw.includes("high")
      ? "high"
      : confRaw.includes("low")
      ? "low"
      : "medium";

    const newsTime = item?.news_time ? String(item.news_time) : "রিলিজ সময়ে";
    const computedTiming = computeOneMinuteEntryGuide(newsTime);

    return {
      id: item?.id || `gen-sig-${index + 1}`,
      news_title: item?.news_title || `${fallbackTitle} #${index + 1}`,
      currency: item?.currency || "USD",
      suggested_pair: item?.suggested_pair || (signal === "BUY" ? "EUR/USD" : "GBP/USD"),
      event: item?.event || "Economic Release",
      news_time: newsTime,
      entry_time: item?.entry_time ? String(item.entry_time) : computedTiming.entryWindow,
      timeframe: item?.timeframe || "1 Minute (1M)",
      actual: item?.actual ?? null,
      forecast: item?.forecast ?? null,
      previous: item?.previous ?? null,
      impact,
      currency_bias,
      signal, // Guaranteed BUY or SELL
      confidence,
      how_to_enter_bn:
        item?.how_to_enter_bn ||
        `${newsTime} নিউজের ঠিক ৩–৫ সেকেন্ড পর ক্যান্ডেলের প্রাথমিক স্পাইক দেখে 1M (${signal}) এন্ট্রি নিন। ১ মিনিট (60s) পর্যন্ত হোল্ড করুন।`,
      reason_bn:
        item?.reason_bn ||
        "নিউজ ডেটা ও ক্যান্ডেল বায়াসের ভিত্তি ধরে ১-মিনিট স্কেলিং সিগন্যাল নির্ধারণ করা হয়েছে।",
      risk_bn:
        item?.risk_bn ||
        "১-মিনিট ট্রেডিংয়ে স্প্রেড পরিবর্তন ও রিভার্সাল হতে পারে। মনি ম্যানেজমেন্ট বজায় রাখুন।",
    };
  });
}

