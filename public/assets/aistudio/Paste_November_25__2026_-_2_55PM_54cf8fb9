    new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        const resultStr = String(reader.result || "");
        const commaIdx = resultStr.indexOf(",");
        resolve(commaIdx >= 0 ? resultStr.slice(commaIdx + 1) : resultStr);
