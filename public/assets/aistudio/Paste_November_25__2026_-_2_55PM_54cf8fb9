              type: "OBJECT",
              properties: {
                news_title: { type: "STRING" },
                currency: { type: "STRING" },
                suggested_pair: { type: "STRING" },
                event: { type: "STRING" },
                news_time: { type: "STRING" },
                entry_time: { type: "STRING" },
                timeframe: { type: "STRING" },
                actual: { type: "STRING", nullable: true },
                forecast: { type: "STRING", nullable: true },
                previous: { type: "STRING", nullable: true },
                impact: { type: "STRING" },
                currency_bias: { type: "STRING" },
                signal: { type: "STRING" },
                confidence: { type: "STRING" },
                how_to_enter_bn: { type: "STRING" },
                reason_bn: { type: "STRING" },
                risk_bn: { type: "STRING" },
              },
              required: [
                "news_title",
                "currency",
                "suggested_pair",
                "event",
                "news_time",
                "entry_time",
                "timeframe",
                "impact",
                "currency_bias",
                "signal",
                "confidence",
                "how_to_enter_bn",
                "reason_bn",
                "risk_bn",
              ],
            },
          },
        },
        required: ["calendar_summary_bn", "extracted_text", "signals"],
      },
    },
  };

  const maxRetries = 3;
  let lastError = null;

  for (let attempt = 0; attempt <= maxRetries; attempt++) {
    try {
      const response = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        const errBody = await response.text().catch(() => "");
        throw new Error(`API অনুরোধ ব্যর্থ (${response.status}): ${errBody.slice(0, 120)}`);
      }

      const data = await response.json();
      const rawJson = data?.candidates?.[0]?.content?.parts?.[0]?.text;
      if (!rawJson) {
        throw new Error("মডেল থেকে কোনো JSON উত্তর পাওয়া যায়নি।");
      }

      const parsed = JSON.parse(rawJson);
      const normalizedSignals = normalizeSignalsArray(
        parsed?.signals,
        "স্ক্রিনশট নিউজ সিগন্যাল"
      );

      if (normalizedSignals.length === 0) {
        throw new Error("স্ক্রিনশট থেকে সিগন্যাল তৈরি করা যায়নি।");
      }

      return {
        calendarSummary:
          parsed?.calendar_summary_bn ||
          "আপলোড করা স্ক্রিনশট থেকে ৪-৫টি সুনির্দিষ্ট ১-মিনিট সিগন্যাল ফিল্টার করে দেখানো হচ্ছে।",
        extractedText: parsed?.extracted_text || rawJson,
        signals: normalizedSignals,
      };
    } catch (err) {
      lastError = err;
      if (attempt < maxRetries) {
        const delayMs = 1000 * Math.pow(2, attempt);
        await new Promise((resolve) => setTimeout(resolve, delayMs));
      }
    }
  }

  throw lastError || new Error("অজানা ত্রুটি ঘটেছে।");
}

