                  </p>
                </div>

                <div className="rounded-xl border border-slate-800 bg-slate-950/70 p-3.5">
                  <p className="font-semibold text-amber-300">
                    ৩. রেড ইমপ্যাক্ট বনাম মিডিয়াম ইমপ্যাক্ট
                  </p>
                  <p className="mt-1 text-slate-400">
                    <span className="font-semibold text-red-300">রেড ইমপ্যাক্ট (High)</span> নিউজে গতি ও স্লিপেজ বেশি থাকে;{" "}
                    <span className="font-semibold text-amber-300">মিডিয়াম ইমপ্যাক্ট (Medium)</span> নিউজে মুভমেন্ট তুলনামূলক সহনীয় হতে পারে, তবে ফলস মুভও সম্ভব।
                  </p>
                </div>
              </div>
            </div>

            <div className="mt-4 flex items-start gap-2.5 rounded-xl border border-amber-500/30 bg-amber-500/10 p-3 text-xs text-amber-200">
              <ShieldAlert className="mt-0.5 h-4 w-4 shrink-0 text-amber-400" />
              <p>
                <strong>সতর্কতা:</strong> কোনো সিগন্যালই নিশ্চিত লাভের গ্যারান্টি নয়। ১-মিনিট ট্রেডিং অত্যন্ত ঝুঁকিপূর্ণ—নিজস্ব রিস্ক ম্যানেজমেন্ট মেনে চলুন।
              </p>
            </div>
          </div>
        </section>

        {/* Active Batch Banner + Red vs Medium Filter Tabs */}
        <section className="mt-9">
          <div className="flex flex-col gap-4 rounded-2xl border border-slate-800 bg-slate-900/90 p-5 md:flex-row md:items-center md:justify-between">
            <div>
              <div className="flex flex-wrap items-center gap-2">
                <span className="rounded-md bg-slate-800 px-2.5 py-0.5 text-xs font-medium text-emerald-300">
                  মোট {counts.all}টি ১-মিনিট সিগন্যাল
                </span>
                <span className="rounded-md bg-red-500/15 px-2.5 py-0.5 text-xs font-medium text-red-300">
                  রেড: {counts.high}টি
                </span>
                <span className="rounded-md bg-amber-500/15 px-2.5 py-0.5 text-xs font-medium text-amber-300">
                  মিডিয়াম: {counts.medium}টি
                </span>
              </div>
              <h2 className="mt-2 text-lg font-bold text-white">{activeBatchTitle}</h2>
              <p className="mt-1 text-xs leading-relaxed text-slate-400 sm:text-sm">
                {calendarSummary}
              </p>
            </div>

            {/* Filter Buttons: All / Red Impact / Medium Impact */}
            <div
              role="tablist"
              aria-label="ইমপ্যাক্ট অনুযায়ী সিগন্যাল ফিল্টার"
              className="flex flex-wrap items-center gap-2"
            >
              <button
                type="button"
                role="tab"
                aria-selected={impactFilter === "ALL"}
                onClick={() => setImpactFilter("ALL")}
                className={`rounded-xl px-3.5 py-2 text-xs font-semibold transition ${
                  impactFilter === "ALL"
                    ? "bg-white text-slate-950 shadow"
                    : "border border-slate-700 bg-slate-800/80 text-slate-300 hover:bg-slate-800"
                }`}
              >
                সব সিগন্যাল ({counts.all})
              </button>

              <button
                type="button"
                role="tab"
                aria-selected={impactFilter === "HIGH"}
                onClick={() => setImpactFilter("HIGH")}
                className={`inline-flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-semibold transition ${
                  impactFilter === "HIGH"
                    ? "bg-red-600 text-white shadow shadow-red-950/60"
                    : "border border-red-500/35 bg-red-500/10 text-red-200 hover:bg-red-500/20"
                }`}
              >
                <Flame className="h-3.5 w-3.5" />
                <span>রেড ইমপ্যাক্ট ({counts.high})</span>
              </button>

              <button
                type="button"
                role="tab"
                aria-selected={impactFilter === "MEDIUM"}
                onClick={() => setImpactFilter("MEDIUM")}
                className={`inline-flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-semibold transition ${
                  impactFilter === "MEDIUM"
                    ? "bg-amber-500 text-slate-950 shadow shadow-amber-950/60"
                    : "border border-amber-500/35 bg-amber-500/10 text-amber-200 hover:bg-amber-500/20"
                }`}
              >
                <Activity className="h-3.5 w-3.5" />
                <span>মিডিয়াম ইমপ্যাক্ট ({counts.medium})</span>
              </button>
            </div>
          </div>

          {/* Signals Cards Grid */}
          {filteredSignals.length === 0 ? (
            <div className="mt-6 rounded-2xl border border-slate-800 bg-slate-900/60 p-8 text-center">
              <p className="text-sm text-slate-300">
                এই ইমপ্যাক্ট ক্যাটাগরিতে বর্তমানে কোনো সিগন্যাল নেই।
              </p>
              <button
                type="button"
                onClick={() => setImpactFilter("ALL")}
                className="mt-3 rounded-lg bg-slate-800 px-4 py-2 text-xs font-medium text-white hover:bg-slate-700"
              >
                সব সিগন্যাল দেখুন
              </button>
            </div>
          ) : (
            <div className="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">
              {filteredSignals.map((sig, idx) => {
                const sigBadge = getSignalBadge(sig.signal);
                const impBadge = getImpactBadge(sig.impact);
                const biasInfo = getBiasLabel(sig.currency_bias);
                const SignalIcon = sigBadge.Icon;
                const ImpactIcon = impBadge.Icon;

                return (
                  <article
                    key={sig.id}
                    className={`flex flex-col justify-between rounded-2xl border p-5 transition ${
                      sig.impact === "high"
                        ? "border-red-500/30 bg-slate-900/90 hover:border-red-500/55"
                        : sig.impact === "medium"
                        ? "border-amber-500/25 bg-slate-900/90 hover:border-amber-500/50"
                        : "border-slate-800 bg-slate-900/85 hover:border-slate-700"
                    }`}
                  >
                    <div>
                      {/* Top row: Signal index, Impact badge, Signal Action */}
                      <div className="flex flex-wrap items-center justify-between gap-2">
                        <div className="flex flex-wrap items-center gap-2">
                          <span className="rounded-md bg-slate-800 px-2 py-0.5 font-mono text-xs text-slate-300">
                            #{idx + 1}
                          </span>
                          <span
                            className={`inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 text-xs font-semibold ${impBadge.classes}`}
                          >
                            <ImpactIcon className="h-3.5 w-3.5" />
                            <span>{impBadge.label}</span>
                          </span>
                          <span className="rounded-full border border-sky-500/30 bg-sky-500/10 px-2.5 py-0.5 text-xs font-medium text-sky-300">
                            {sig.timeframe}
                          </span>
                        </div>

                        <div
                          className={`inline-flex items-center gap-1.5 rounded-xl border px-3 py-1 text-xs font-bold ${sigBadge.classes}`}
                        >
                          <SignalIcon className="h-4 w-4" />
                          <span>{sigBadge.label}</span>
                        </div>
                      </div>

                      {/* Title & Pair/Currency */}
                      <div className="mt-3.5">
                        <h3 className="text-base font-bold text-white">
                          {sig.news_title}
                        </h3>
                        <div className="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-400">
                          <span>
                            কারেন্সি: <strong className="text-slate-200">{sig.currency}</strong>
                          </span>
                          <span>•</span>
                          <span>
                            পেয়ার:{" "}
                            <strong className="text-emerald-300">{sig.suggested_pair}</strong>
                          </span>
                          <span>•</span>
                          <span>
                            বায়াস:{" "}
                            <strong className={biasInfo.cls}>{biasInfo.text}</strong>
                          </span>
                        </div>
                      </div>

                      {/* Clear Time Box (News Time vs 1M Entry Time) */}
                      <div className="mt-4 grid grid-cols-1 gap-2.5 rounded-xl border border-slate-800 bg-slate-950/80 p-3 sm:grid-cols-2">
                        <div>
                          <span className="block text-[11px] text-slate-400">
                            ইভেন্ট / নিউজ সময়
                          </span>
                          <span className="mt-0.5 inline-flex items-center gap-1.5 font-mono text-sm font-semibold text-white">
                            <Clock className="h-3.5 w-3.5 text-sky-400" />
                            {sig.news_time}
                          </span>
                        </div>
                        <div>
                          <span className="block text-[11px] text-slate-400">
                            ১-মিনিট এন্ট্রি সময় (কত সময়ে দেবেন)
                          </span>
                          <span className="mt-0.5 inline-flex items-center gap-1.5 font-mono text-sm font-bold text-emerald-300">
                            <ArrowRight className="h-3.5 w-3.5 text-emerald-400" />
                            {sig.entry_time}
                          </span>
                        </div>
                      </div>

                      {/* Actual / Forecast / Previous */}
                      <div className="mt-3 grid grid-cols-3 gap-2 text-center">
                        <div className="rounded-lg border border-slate-800/90 bg-slate-950/50 p-2">
                          <span className="block text-[10px] uppercase tracking-wider text-slate-400">
                            Actual
                          </span>
                          <span className="mt-0.5 block font-mono text-xs font-semibold text-white">
                            {sig.actual || "N/A"}
                          </span>
                        </div>
                        <div className="rounded-lg border border-slate-800/90 bg-slate-950/50 p-2">
                          <span className="block text-[10px] uppercase tracking-wider text-slate-400">
                            Forecast
                          </span>
                          <span className="mt-0.5 block font-mono text-xs font-semibold text-slate-200">
                            {sig.forecast || "N/A"}
                          </span>
                        </div>
                        <div className="rounded-lg border border-slate-800/90 bg-slate-950/50 p-2">
                          <span className="block text-[10px] uppercase tracking-wider text-slate-400">
                            Previous
                          </span>
                          <span className="mt-0.5 block font-mono text-xs font-semibold text-slate-300">
                            {sig.previous || "N/A"}
                          </span>
                        </div>
                      </div>

                      {/* How to enter (1M step-by-step) */}
                      <div className="mt-4 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-3">
                        <p className="text-xs font-semibold text-emerald-300">
                          কীভাবে ১-মিনিটের ট্রেড নেবেন:
                        </p>
                        <p className="mt-1 text-xs leading-relaxed text-slate-200">
                          {sig.how_to_enter_bn}
                        </p>
                      </div>

                      {/* Reason */}
                      <div className="mt-3">
                        <p className="text-xs font-semibold text-slate-300">
                          বিশ্লেষণের কারণ:
                        </p>
                        <p className="mt-1 text-xs leading-relaxed text-slate-400">
                          {sig.reason_bn}
                        </p>
                      </div>
                    </div>

                    {/* Risk Note */}
                    <div className="mt-4 border-t border-slate-800/90 pt-3 text-[11px] leading-relaxed text-amber-200/90">
                      <span className="font-semibold text-amber-300">ঝুঁকি সতর্কতা: </span>
                      {sig.risk_bn}
                    </div>
                  </article>
                );
              })}
            </div>
          )}

          {/* Expandable Extracted Text / Raw Data */}
          <div className="mt-6 rounded-2xl border border-slate-800 bg-slate-900/70 p-4">
            <button
              type="button"
              onClick={() => setShowExtractedText((prev) => !prev)}
              className="flex w-full items-center justify-between text-left text-xs font-semibold text-slate-300 hover:text-white"
            >
              <span className="flex items-center gap-2">
                <FileText className="h-4 w-4 text-slate-400" />
                <span>স্ক্রিনশট / ক্যালেন্ডার থেকে প্রাপ্ত তথ্য দেখুন</span>
              </span>
              {showExtractedText ? (
                <ChevronUp className="h-4 w-4 text-slate-400" />
              ) : (
                <ChevronDown className="h-4 w-4 text-slate-400" />
              )}
            </button>

            {showExtractedText && (
              <pre className="mt-3 overflow-x-auto whitespace-pre-wrap rounded-xl border border-slate-800 bg-slate-950 p-3.5 font-mono text-xs text-slate-300">
                {extractedText}
              </pre>
            )}
          </div>
        </section>

        {/* Bottom Disclaimer */}
        <footer className="mt-10 rounded-2xl border border-slate-800/90 bg-slate-900/60 p-4 text-xs leading-relaxed text-slate-400">
          <p>
            <strong className="text-slate-200">অস্বীকৃতি (Disclaimer):</strong> এই ওয়েবসাইটটি শুধুমাত্র শিক্ষামূলক ও নিউজ বিশ্লেষণ সহায়তার জন্য তৈরি। ফরেক্স ও ১-মিনিট (1M) ট্রেডিংয়ে উচ্চ মাত্রার আর্থিক ঝুঁকি রয়েছে এবং কোনো সিগন্যালই নিশ্চিত বা গ্যারান্টিড লাভের প্রতিশ্রুতি দেয় না। নিজস্ব দায়িত্বে ও ঝুঁকি ব্যবস্থাপনা মেনে সিদ্ধান্ত নিন।
          </p>
        </footer>
      </div>
    </div>
  );
}